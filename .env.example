# =====================================================================
# Neon Serverless PostgreSQL - Environment Variables
# =====================================================================

# Neon Serverless PostgreSQL Connection String (Pooled or Direct)
# Obtain your free connection string from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional: Connection pool limit per serverless function (Default: 10)
DB_CONNECTION_LIMIT=10

# ---------------------------------------------------------------------
# Application & Authentication Settings
# ---------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=meal-distribution-neon-jwt-secret-key-change-in-prod
