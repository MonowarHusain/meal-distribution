# =====================================================================
# Meal Distribution System - Environment Variables
# =====================================================================

# ---------------------------------------------------------------------
# Option A: Single Database URI (Recommended for Cloud Providers)
# Works out of the box with Aiven, TiDB Cloud, Supabase, Railway, etc.
# ---------------------------------------------------------------------
DATABASE_URL=mysql://avnadmin:your_password@mysql-service.aivencloud.com:13306/defaultdb?ssl-mode=REQUIRED

# ---------------------------------------------------------------------
# Option B: Discrete MySQL Connection Parameters
# Used automatically if DATABASE_URL is not set.
# ---------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=meal_distribution

# ---------------------------------------------------------------------
# SSL & Connection Pooling Settings (Critical for Serverless Lambdas)
# ---------------------------------------------------------------------
# Set to 'false' to disable SSL for local development without SSL.
# Default is true (required by Aiven & TiDB Cloud).
DB_SSL=true

# Set to 'false' to permit managed cloud self-signed certificates (default: false)
DB_SSL_REJECT_UNAUTHORIZED=false

# Max pool connections per serverless function (default: 10)
DB_CONNECTION_LIMIT=10

# ---------------------------------------------------------------------
# Application Configuration
# ---------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=meal-distribution-secret-key-change-in-production
